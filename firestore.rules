rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile and subcollections: allowed for authenticated users for their own data, or demo access
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Allow demo/test reading if needed
      allow read, write: if request.auth != null;

      match /vault/{cardId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read, write: if request.auth != null;
      }
    }
    
    // Fallback for public demo collections
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
