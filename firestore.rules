rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile and subcollections: allowed for authenticated users for their own data, or demo access
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Allow demo/test reading if needed
      allow read, write: if request.auth != null;

      match /vault/{cardId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read, write: if request.auth != null;
      }
    }
    
    // Public verification of certificates, slabs, and public ledger events
    match /certificates/{certId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /slabs/{slabId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /ledger_records/{recordId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /reference_cards/{refId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Fallback for demo and authenticated collections
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
